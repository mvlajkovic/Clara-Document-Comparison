<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Clara.DocumentComparison</RootNamespace>
    <AssemblyName>Clara.DocumentComparison</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      That's it — just the two libraries this app actually uses.
      Everything each of them needs underneath (logging shims, crypto
      libraries, PDF tokenizers, etc.) is resolved automatically by NuGet
      when the project restores. No HintPath entries, no binding redirects.
    -->
    <PackageReference Include="itext" Version="9.7.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="docs\" />
  </ItemGroup>

</Project>
